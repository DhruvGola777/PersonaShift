# PersonaShift Environment Configuration

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Backend Server Port (defaults to 3001)
PORT=3001

# Optional: Gemini Model identifier (defaults to gemini-3.1-flash-lite)
GEMINI_MODEL=gemini-3.1-flash-lite

# deAPI Multimodal Perspective Audio (Milestone 7)
DEAPI_API_KEY=your_deapi_api_key_here

# Optional: deAPI TTS Model (defaults to Kokoro)
DEAPI_TTS_MODEL=Kokoro

# Optional: deAPI TTS Voice (defaults to af_sky)
DEAPI_TTS_VOICE=af_sky
